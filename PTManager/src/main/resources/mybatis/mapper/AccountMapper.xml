<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="mybatis.mapper.AccountMapper">
	<cache />
	
	<sql id="BaseColumns">
		SELECT userid AS userId, name, email, phone, role, height
        FROM account2
	</sql>
	
	<!-- 회원(일반, PT 전체) 리스트 -->
	<select id="selectAllMember" resultType="AccountDTO">
		<include refid="BaseColumns" />
        WHERE role IN ('MEMBER', 'PTMEMBER')
	</select>
	
	<!-- 일반 회원 리스트 -->
	<select id="selectMember" resultType="AccountDTO">
		<include refid="BaseColumns" />
        WHERE role = 'MEMBER'
	</select>
	
	<!-- PT 회원 리스트 -->
	<select id="selectPtMember" resultType="AccountDTO">
		<include refid="BaseColumns" />
        WHERE role = 'PTMEMBER'
	</select>
	
	<!-- 트레이너가 PT를 신청하는 회원을 검색할 때 사용 -->
	<!-- 일반 회원 중 아이디로 회원 검색 -->
	<select id="selectMemberById" parameterType="string" resultType="AccountDTO" >
		<include refid="BaseColumns" />
        WHERE userid = #{userId} AND role = 'MEMBER'
	</select>
	
	<!-- 일반 회원 중 회원 이름으로 검색(여러 명 출력 가능) -->
	<select id="selectMemberByName" parameterType="string" resultType="AccountDTO">
		<include refid="BaseColumns" />
        WHERE name = #{name} AND role = 'MEMBER'
	</select>
	
	<!-- 모든 회원 중 아이디로 검색  -->
	<select id="selectAllMemberById" parameterType="string" resultType="AccountDTO">
		<include refid="BaseColumns" />
		WHERE userid = #{userId}
	</select>
	
	<!-- 아이디 중복 확인 (0이면 사용 가능, 아닐 시 이미 존재하는 아이디 -->
	<select id="selectDuplicateIdCount" parameterType="string" resultType="int">
		SELECT COUNT(*) AS countUserId
		FROM account2 
		WHERE userid = #{userId}
	</select>
	
	<!-- 회원가입 -->
	<select id="insertAccount" parameterType="AccountDTO">
		INSERT INTO account2 (userid, password, name, email, phone, role, height)
        VALUES (#{userId}, #{password}, #{name}, #{email}, #{phone}, #{role}, #{height})
	</select>
	
	<!-- 회원 탈퇴 -->
	<delete id="deleteAccount" parameterType="string">
		DELECT FROM account2 
		WHERE userid = #{userId}
	</delete>
	
	<!-- 회원 정보 수정 -->
	<update id="updateAccount" parameterType="AccountDTO">
		UPDATE account SET
        password = #{password}, name = #{name}, email = #{email}, phone = #{phone}, height = #{height}
       	WHERE userid = #{userId}
	</update>
	
</mapper>